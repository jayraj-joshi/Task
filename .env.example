# Required for LLM calls (unless using Azure variables below)
OPENAI_API_KEY=

# Optional overrides
PAGEINDEX_MODEL=gpt-4o-2024-11-20
CHUNKSMITH_PDF_PARSER=PyPDF2
CHUNKSMITH_MAX_TOKENS_PER_CHUNK=20000
CHUNKSMITH_OVERLAP_PAGES=1
# After the outline tree is built, one extra LLM call for a one-line doc_description (separate from TOC prompts)
# CHUNKSMITH_GENERATE_DOC_SUMMARY=true

# Azure OpenAI (optional — if endpoint is set, Azure is used instead of OPENAI_API_KEY)
# Same variable names as app/.env: deployment name is usually AZURE_OPENAI_CHAT_MODEL.
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_CHAT_MODEL=
# AZURE_OPENAI_CHAT_DEPLOYMENT=   # optional alias if you prefer this name
